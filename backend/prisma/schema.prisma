generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  chargingSessions ChargingSession[]
  payments         Payment[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model ChargingStation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  addressLine1   String   @map("address_line_1")
  addressLine2   String?  @map("address_line_2")
  city           String
  state          String
  postalCode     String   @map("postal_code")
  country        String   @default("US")
  latitude       Decimal  @db.Decimal(10, 8)
  longitude      Decimal  @db.Decimal(11, 8)
  operatorName   String   @map("operator_name")
  operatorLogoUrl String? @map("operator_logo_url")
  amenities      String[]
  totalPorts     Int      @map("total_ports")
  availablePorts Int      @map("available_ports")
  rating         Decimal? @db.Decimal(3, 2)
  ratingCount    Int      @default(0) @map("rating_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  connectors       Connector[]
  chargingSessions ChargingSession[]

  @@map("charging_stations")
}

model Connector {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId      String          @map("station_id") @db.Uuid
  portNumber     Int             @map("port_number")
  connectorType  ConnectorType   @map("connector_type")
  powerKw        Decimal         @db.Decimal(6, 2) @map("power_kw")
  currentType    CurrentType     @map("current_type")
  status         ConnectorStatus @default(AVAILABLE)
  pricePerKwh    Decimal         @db.Decimal(8, 4) @map("price_per_kwh")
  pricePerMinute Decimal?        @db.Decimal(8, 4) @map("price_per_minute")
  sessionFee     Decimal         @default(0) @db.Decimal(8, 4) @map("session_fee")
  qrCodeData     String          @unique @map("qr_code_data")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  station          ChargingStation   @relation(fields: [stationId], references: [id])
  chargingSessions ChargingSession[]

  @@index([stationId])
  @@index([status])
  @@map("connectors")
}

enum ConnectorType {
  CCS1
  CCS2
  CHADEMO
  TYPE2
  J1772
  TESLA_NACS
}

enum CurrentType {
  AC
  DC
}

enum ConnectorStatus {
  AVAILABLE
  OCCUPIED
  FAULTED
  OFFLINE
  RESERVED
}

model ChargingSession {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  connectorId       String        @map("connector_id") @db.Uuid
  stationId         String        @map("station_id") @db.Uuid
  status            SessionStatus @default(PENDING_PAYMENT)
  startedAt         DateTime?     @map("started_at")
  endedAt           DateTime?     @map("ended_at")
  energyKwh         Decimal       @default(0) @db.Decimal(10, 4) @map("energy_kwh")
  durationMinutes   Int           @default(0) @map("duration_minutes")
  totalCost         Decimal       @default(0) @db.Decimal(10, 2) @map("total_cost")
  stoppedReason     String?       @map("stopped_reason")
  ocppTransactionId String?       @unique @map("ocpp_transaction_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id])
  connector Connector       @relation(fields: [connectorId], references: [id])
  station   ChargingStation @relation(fields: [stationId], references: [id])
  payment   Payment?

  @@index([userId])
  @@index([connectorId])
  @@index([status])
  @@index([createdAt])
  @@map("charging_sessions")
}

enum SessionStatus {
  PENDING_PAYMENT
  PAYMENT_AUTHORIZED
  STARTING
  ACTIVE
  STOPPING
  COMPLETED
  FAILED
  CANCELLED
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  sessionId             String        @unique @map("session_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  stripeCustomerId      String?       @map("stripe_customer_id")
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  capturedAmount        Decimal?      @db.Decimal(10, 2) @map("captured_amount")
  refundedAmount        Decimal?      @db.Decimal(10, 2) @map("refunded_amount")
  failureReason         String?       @map("failure_reason")
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id])
  session ChargingSession @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIALLY_CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
